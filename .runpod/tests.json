{
  "tests": [
    {
      "name": "z_image_turbo_txt2img",
      "input": {
        "workflow": {
          "6": {
            "inputs": { "text": "a beautiful sunset over mountains, photorealistic", "clip": ["30", 0] },
            "class_type": "CLIPTextEncode"
          },
          "8": {
            "inputs": { "samples": ["31", 0], "vae": ["30", 2] },
            "class_type": "VAEDecode"
          },
          "9": {
            "inputs": { "filename_prefix": "ComfyUI", "images": ["8", 0] },
            "class_type": "SaveImage"
          },
          "27": {
            "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
            "class_type": "EmptyLatentImage"
          },
          "30": {
            "inputs": { "unet_name": "z-image-turbo-diffusion_model.safetensors", "weight_dtype": "default" },
            "class_type": "UNETLoader"
          },
          "31": {
            "inputs": {
              "seed": 42, "steps": 8, "cfg": 0, "sampler_name": "euler",
              "scheduler": "normal", "denoise": 1,
              "model": ["30", 0], "positive": ["6", 0],
              "negative": ["33", 0], "latent_image": ["27", 0]
            },
            "class_type": "KSampler"
          },
          "33": {
            "inputs": { "text": "", "clip": ["30", 0] },
            "class_type": "CLIPTextEncode"
          }
        }
      },
      "timeout": 120000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA GeForce RTX 4090",
    "gpuCount": 1,
    "env": [
      { "key": "WORKFLOW", "value": "z-image-turbo" }
    ],
    "allowedCudaVersions": ["12.8", "12.7", "12.6", "12.5", "12.4"]
  }
}
