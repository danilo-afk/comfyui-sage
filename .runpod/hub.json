{
  "title": "ComfyUI Z-Image Turbo",
  "description": "ComfyUI serverless worker with Z-Image Turbo pre-loaded. Uncensored 6B image generation with SageAttention optimization.",
  "type": "serverless",
  "category": "image",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 30,
    "gpuCount": 1,
    "gpuIds": "NVIDIA RTX A6000,NVIDIA GeForce RTX 4090,NVIDIA L40",
    "allowedCudaVersions": ["12.8", "12.7", "12.6", "12.5", "12.4"]
  },
  "env": [
    {
      "key": "WORKFLOW",
      "input": {
        "type": "string",
        "name": "Workflow",
        "default": "z-image-turbo"
      }
    },
    {
      "key": "HF_TOKEN",
      "input": {
        "type": "string",
        "name": "HuggingFace Token (optional)",
        "default": ""
      }
    }
  ]
}
